# ---------------------------------------------------------------------------
# FieldServiceChoice environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. The app runs WITHOUT Supabase configured — it will
# fall back to the local seed data in /data so you can develop the UI offline.
# ---------------------------------------------------------------------------

# Public site URL (used for canonicals, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://fieldservicechoice.com

# --- Supabase (optional for local dev; required for real leads/admin) --------
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe for the browser, RLS-guarded).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The service-role key. SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Anti-spam (optional) ----------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Transactional email (optional) -----------------------------------------
EMAIL_PROVIDER_KEY=
LEAD_NOTIFICATION_TO=
